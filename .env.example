# Copy to .env and fill in. Never commit .env.

# From https://developer.spotify.com/dashboard -> your app -> Settings.
# PKCE is used, so no client secret is needed or read.
SPOTIFY_CLIENT_ID=

# Must exactly match a Redirect URI registered in the dashboard.
# Spotify rejects "localhost"; use the loopback IP literal.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Where the SQLite database and token cache live. Kept out of git.
CURATOR_DATA_DIR=./data

# Optional: DEBUG, INFO, WARNING
CURATOR_LOG_LEVEL=INFO
